// Konfiguracja strony na Cloudflare (Worker ze stroną statyczną).
// Bot ma osobną konfigurację w folderze bot/.
// Domeny MUSZĄ być wpisane tutaj – inaczej każde automatyczne wdrożenie
// (np. po nowym wpisie od bota) mogłoby je odłączyć.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krajewskastudio",
  "compatibility_date": "2026-11-23",
  "observability": { "enabled": true },
  "assets": { "directory": "." },
  "routes": [
    { "pattern": "krajewskastudio.pl", "custom_domain": true },
    { "pattern": "www.krajewskastudio.pl", "custom_domain": true }
  ]
}
