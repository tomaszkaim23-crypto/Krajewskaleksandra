// Konfiguracja strony na Cloudflare (Worker ze stroną statyczną).
// Bot ma osobną konfigurację w folderze bot/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krajewskastudio",
  "compatibility_date": "2026-11-23",
  "observability": { "enabled": true },
  "assets": { "directory": "." }
}
